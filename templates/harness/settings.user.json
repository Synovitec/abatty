{
  "$schema": "",

  "permissions": {
    "defaultMode": "auto",

    "allow": [
      "Read", "Edit", "Write", "Glob", "Grep", "NotebookEdit",
      "Agent", "Skill", "ToolSearch", "LSP",
      "TaskCreate", "TaskUpdate", "TaskGet", "TaskList", "TaskOutput", "TaskStop",
      "WebFetch", "WebSearch",
      "EnterPlanMode", "ExitPlanMode", "EnterWorktree", "ExitWorktree",

      "Bash(git status *)", "Bash(git diff *)", "Bash(git log *)", "Bash(git show *)",
      "Bash(git add *)", "Bash(git commit *)", "Bash(git fetch *)", "Bash(git pull *)",
      "Bash(git push *)", "Bash(git checkout *)", "Bash(git switch *)", "Bash(git branch *)",
      "Bash(git stash *)", "Bash(git merge-base *)", "Bash(git rev-parse *)", "Bash(git ls-files *)",
      "Bash(git restore *)", "Bash(git worktree *)", "Bash(git config core.hooksPath *)",
      "Bash(npm *)", "Bash(npx *)", "Bash(pnpm *)", "Bash(node *)", "Bash(tsc *)",
      "Bash(corepack *)", "Bash(prisma *)", "Bash(next *)", "Bash(turbo *)", "Bash(vitest *)",
      "Bash(playwright *)", "Bash(eslint *)", "Bash(prettier *)",
      "Bash(docker info *)", "Bash(docker ps *)", "Bash(docker logs *)", "Bash(docker compose ps *)",
      "Bash(bash scripts/*)", "Bash(sh scripts/*)",
      "Bash(ls *)", "Bash(cat *)", "Bash(head *)", "Bash(tail *)", "Bash(wc *)", "Bash(find *)",
      "Bash(grep *)", "Bash(rg *)", "Bash(sed *)", "Bash(awk *)", "Bash(sort *)", "Bash(uniq *)",
      "Bash(diff *)", "Bash(mkdir *)", "Bash(cp *)", "Bash(mv *)", "Bash(touch *)", "Bash(echo *)",
      "Bash(printf *)", "Bash(which *)", "Bash(env *)", "Bash(curl *)", "Bash(jq *)",
      "Bash(pass-cli *)",

      "PowerShell(git status *)", "PowerShell(git diff *)", "PowerShell(git log *)", "PowerShell(git show *)",
      "PowerShell(git add *)", "PowerShell(git commit *)", "PowerShell(git fetch *)", "PowerShell(git pull *)",
      "PowerShell(git push *)", "PowerShell(git checkout *)", "PowerShell(git switch *)", "PowerShell(git branch *)",
      "PowerShell(git stash *)", "PowerShell(git merge-base *)", "PowerShell(git rev-parse *)", "PowerShell(git ls-files *)",
      "PowerShell(git restore *)", "PowerShell(git worktree *)",
      "PowerShell(npm *)", "PowerShell(npx *)", "PowerShell(pnpm *)", "PowerShell(node *)", "PowerShell(tsc *)",
      "PowerShell(corepack *)", "PowerShell(prisma *)", "PowerShell(next *)", "PowerShell(turbo *)",
      "PowerShell(docker info *)", "PowerShell(docker ps *)", "PowerShell(docker logs *)",
      "PowerShell(Get-ChildItem *)", "PowerShell(Get-Content *)", "PowerShell(Select-String *)",
      "PowerShell(Test-Path *)", "PowerShell(New-Item *)", "PowerShell(Copy-Item *)", "PowerShell(Move-Item *)",
      "PowerShell(Measure-Object *)", "PowerShell(Get-Command *)", "PowerShell(Get-Process *)",
      "PowerShell(Stop-Process *)", "PowerShell(Invoke-WebRequest *)", "PowerShell(Invoke-RestMethod *)"
    ],

    "ask": [
      "Bash(git reset --hard *)", "PowerShell(git reset --hard *)",
      "Bash(git clean *)", "PowerShell(git clean *)"
    ],

    "deny": [
      "Read(./.env)", "Read(./.env.*)", "Read(~/.ssh/**)", "Read(~/.aws/**)",
      "Bash(git push --force *)", "Bash(git push -f *)", "Bash(git push --force-with-lease *)",
      "PowerShell(git push --force *)", "PowerShell(git push -f *)",
      "Bash(git commit --no-verify *)", "Bash(git commit -n *)", "Bash(git push --no-verify *)",
      "PowerShell(git commit --no-verify *)", "PowerShell(git push --no-verify *)",
      "Bash(npm publish *)", "Bash(pnpm publish *)", "PowerShell(npm publish *)", "PowerShell(pnpm publish *)",
      "Bash(rm -rf / *)", "Bash(rm -rf ~ *)", "Bash(rm -rf .git *)"
    ],

    "disableBypassPermissionsMode": "disable"
  },

  "autoMode": {
    "allow": [
      "$defaults",
      "Pushing to a branch named adopt/*, feat/*, fix/* or refactor/* of the repository being worked in",
      "Running the repository's own npm/pnpm scripts, its scripts/ci/*, Playwright, Vitest, Testcontainers and docker compose for the local dev database"
    ],
    "soft_deny": [
      "$defaults",
      "Any deploy, publish or release command (Coolify, docker compose against a production compose file, npm publish)",
      "Any migration run against a database that is not the local dev container",
      "Any command that edits .env, .env.* or a file under ~/.ssh"
    ],
    "environment": [
      "**Source control**: Synovitec GitHub organisation; the trusted repo is the one in the working directory and its origin remote only",
      "**CI**: Woodpecker on ci.synovitec.com, triggered by push; deploys are Coolify webhooks on main only",
      "**Adoption branches**: adopt/standards-<date> is the unattended-work branch; pushing to it is routine, pushing to main is not",
      "**Protected**: anything with prod/production in the name, .env.production, docker-compose.production.yml"
    ]
  },

  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },

  "askUserQuestionTimeout": "5m",
  "outputStyle": "Proactive",
  "effortLevel": "high",
  "fileCheckpointingEnabled": true
}
