{
  "name": "abatty",
  "version": "0.1.0",
  "description": "abatty - the Synovitec engineering standard as an installable instrument: init a repository per stack, measure it, gate it, run the unattended adoption nights, keep the harness in step.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Synovitec/abatty.git"
  },
  "bugs": {
    "url": "https://github.com/Synovitec/abatty/issues"
  },
  "keywords": [
    "engineering-standard",
    "ratchet",
    "gate",
    "harness",
    "agents",
    "ci",
    "code-quality"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "private": false,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "abatty": "./bin/abatty.mjs"
  },
  "exports": {
    ".": {
      "types": "./types/src/index.d.mts",
      "default": "./src/index.mjs"
    },
    "./gap-analysis": {
      "types": "./types/src/core/gap-analysis.d.mts",
      "default": "./src/core/gap-analysis.mjs"
    },
    "./presets": {
      "types": "./types/src/presets/index.d.mts",
      "default": "./src/presets/index.mjs"
    },
    "./rules": {
      "types": "./types/src/rules/index.d.mts",
      "default": "./src/rules/index.mjs"
    },
    "./scrub-map": {
      "types": "./types/src/core/scrub-map.d.mts",
      "default": "./src/core/scrub-map.mjs"
    },
    "./vocabulary": {
      "types": "./types/src/core/vocabulary.d.mts",
      "default": "./src/core/vocabulary.mjs"
    },
    "./config": {
      "types": "./types/src/core/config.d.mts",
      "default": "./src/core/config.mjs"
    }
  },
  "files": [
    "bin",
    "src",
    "types",
    "templates",
    "schema",
    "docs/standard",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test \"test/*.test.mjs\"",
    "typecheck": "tsc -p tsconfig.json",
    "format": "prettier --write .",
    "format:check": "prettier --check --end-of-line auto .",
    "gate": "npm run -s format:check && npm run -s typecheck && npm test && npm run -s standards && npm run -s secrets && node bin/abatty.mjs scrub .",
    "gate:fast": "npm run -s gate",
    "hooks:install": "git config core.hooksPath .githooks",
    "standards": "node bin/abatty.mjs ratchet --range auto",
    "standards:baseline": "node bin/abatty.mjs baseline",
    "types": "tsc -p tsconfig.types.json",
    "secrets": "node bin/abatty.mjs secrets",
    "prepublishOnly": "npm run -s gate",
    "pack:check": "npm pack --dry-run"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.0"
  },
  "homepage": "https://abatty.io",
  "types": "./types/src/index.d.mts"
}
